# --- required in production ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/news_engine
ENGINE_API_KEY=change-me-long-random-admin-key        # full access (sources, webhooks, admin)
ENGINE_READ_KEY=change-me-long-random-read-key        # app + Claude: stories, feeds, profiles, briefs

# --- optional: LLM tagging + post drafting --------------------------------------
# Without it: keyword tagging, and post *briefs* (the app's own Claude writes the post).
ANTHROPIC_API_KEY=
TAG_MODEL=claude-haiku-5-5
WRITE_MODEL=claude-sonnet-5-5

# --- digests + thumbnails ----------------------------------------------------------
PUBLIC_BASE_URL=https://engine.backyardsaas.com   # makes thumbnail URLs absolute
BRAND_NAME=                        # printed in the corner of thumbnails (leave blank for none)
DIGEST_MODEL=claude-haiku-5-5
DIGEST_MIN_WORDS=250
DIGEST_MAX_WORDS=500
DIGEST_PER_HOUR=60                 # background budget; on-demand requests are extra

# --- crawling --------------------------------------------------------------------
ENGINE_USER_AGENT=NewsEngineBot/1.0 (+https://engine.backyardsaas.com/bot)
PER_DOMAIN_INTERVAL_SEC=2          # politeness: min gap between hits to one site
SOURCE_CONCURRENCY=6               # sources fetched in parallel
DEFAULT_SOURCE_INTERVAL_MIN=20     # how often each source is checked unless set per source
MAX_ARTICLE_AGE_HOURS=72           # ignore anything older on discovery

# --- clustering / retention / loop -------------------------------------------------
CLUSTER_WINDOW_HOURS=72
CLUSTER_THRESHOLD=0.42             # higher = stricter merging
TRENDING_SOURCE_COUNT=3            # outlets needed to fire story.trending
KEEP_BODY_DAYS=7                   # article full text (internal) is purged after this
KEEP_STORY_DAYS=30
WORKER_TICK_SEC=15
